{
  "name": "dev-ai-assistant-fullstack",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch server/_core/index.ts",
    "build": "vite build && esbuild server/_core/index.ts --platform=node --bundle --format=esm --outfile=dist/index.js --external:postgres",
    "check": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "db:push": "drizzle-kit generate && drizzle-kit migrate",
    "vercel-build": "vite build && ./node_modules/.bin/esbuild server/_core/index.ts --platform=node --bundle --format=esm --outfile=dist/index.js --external:postgres"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.693.0",
    "@aws-sdk/s3-request-presigner": "^3.693.0",
    "@trpc/client": "^11.0.0-rc.666",
    "@trpc/react-query": "^11.0.0-rc.666",
    "@trpc/server": "^11.0.0-rc.666",
    "cookie": "^1.0.2",
    "drizzle-orm": "^0.38.3",
    "express": "^4.21.2",
    "postgres": "^3.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "superjson": "^2.2.2",
    "zod": "^3.24.1",
    "@tailwindcss/vite": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "@tanstack/react-query": "^5.62.7",
    "@tanstack/react-query-devtools": "^5.62.7",
    "@trpc/client": "^11.0.0-rc.666",
    "@trpc/react-query": "^11.0.0-rc.666",
    "lucide-react": "^0.474.0",
    "nanoid": "^5.0.9",
    "wouter": "^3.7.1",
    "sonner": "^1.7.1",
    "qrcode": "^1.5.4",
    "@types/qrcode": "^1.5.5",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.5.5"
  },
  "devDependencies": {
    "@types/cookie": "^0.6.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "drizzle-kit": "^0.30.1",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
