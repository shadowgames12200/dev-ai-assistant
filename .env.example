# Supabase/PostgreSQL pooler connection string
DATABASE_URL=

# Long random secret used to sign session cookies
JWT_SECRET=

# Secret server-side usado para aprovar auto-melhorias e ações administrativas.
# Nunca coloque este valor no frontend nem o comite no repositório.
APPROVAL_KEY=

# Configure one direct provider. GROQ_API_KEY takes precedence over the legacy Forge variables.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
# Optional legacy Manus Forge gateway variables (used when no direct provider key is set).
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Optional application/auth settings
VITE_APP_ID=
OAUTH_SERVER_URL=
# Para conta local, use o openId no formato local:email-da-conta.
# O mesmo identificador protege o dono contra revogação/exclusão acidental.
OWNER_OPEN_ID=

# Optional Pix/notification settings
PIX_KEY=
PIX_RECEIVER_NAME=
PIX_CITY=
SUPPORT_WHATSAPP_NUMBER=
# Alternativas recomendadas: informe somente URLs públicas de atendimento.
SUPPORT_WHATSAPP_URL=
SUPPORT_DISCORD_URL=
SUPPORT_EMAIL=
OWNER_NOTIFICATION_EMAIL=
