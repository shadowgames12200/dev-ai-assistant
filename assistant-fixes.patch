[32m+[m
[32m+[m[32mexport function detectAssistantMode(content: string): AssistantMode {[m
[32m+[m[32m  const text = content.toLowerCase();[m
[32m+[m[32m  if (includesAny(text, ["kiwify", "produto digital", "ebook", "e-book", "infoproduto", "vender online"])) return "kiwify";[m
[32m+[m[32m  if (includesAny(text, ["99freelas", "freela", "freelance", "proposta para cliente", "briefing do cliente", "trabalho para cliente"])) return "freelancer";[m
[32m+[m[32m  if (includesAny(text, ["código", "codigo", "bug", "erro", "typescript", "javascript", "react", "python", "api", "programação", "programacao"])) return "coding";[m
[32m+[m[32m  if (includesAny(text, ["organizar", "produtividade", "rotina", "planejamento", "checklist", "tarefas", "cronograma"])) return "productivity";[m
[32m+[m[32m  return "general";[m
[32m+[m[32m}[m
